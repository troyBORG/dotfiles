{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"command": {
  "parallel": false
},
"logo": {
  "padding": {
    "top": 2,
    "left": 1,
    "right": 1
  }
},
"display": {
  "separator": "",
  "size": {
    "binaryPrefix": "si",
    "ndigits": 0
  },
  "percent": {
    "type": 2
  },
  "bar": {
    "char": {
      "elapsed": "█",
      "total": "░"
    }
  },
  "key": {
    "width": 6
  }
},
"modules": [
  {
    "type": "title",
    "color": {
      "user": "35",
      "host": "36"
    }
  },
  {
    "type": "separator",
    "string": "▔"
  },
  {
    "type": "os",
    "key": "╭─",
    "format": "{3} ({12})",
    "keyColor": "32"
  },
  {
    "type": "host",
    "key": "├─󰟀",
    "keyColor": "32"
  },
  {
    "type": "kernel",
    "key": "├─󰒔",
    "format": "{1} {2}",
    "keyColor": "32"
  },
  {
    "type": "shell",
    "key": "├─$",
    "format": "{1} {4}",
    "keyColor": "32"
  },
  {
    "type": "packages",
    "key": "├─",
    "keyColor": "32"
  },
  {
    "type": "uptime",
    "key": "╰─󰔚",
    "keyColor": "32"
  },
  "break",
  {
    "type": "cpu",
    "key": "╭─",
    "keyColor": "34",
    "freqNdigits": 1,
    "temp": true
  },
  {
    "type": "board",
    "key": "├─󱤓",
    "keyColor": "34"
  },
  {
    "type": "gpu",
    "key": "├─󰢮",
    "keyColor": "34",
    "driverSpecific": true,
    "temp": true
  },
  {
    "type": "sound",
    "key": "├─󰓃",
    "format": "{name}",
    "keyColor": "34"
  },
  {
    "type": "battery",
    "key": "├─󰁹",
    "keyColor": "34"
  },
  {
    "type": "memory",
    "key": "├─",
    "keyColor": "34"
  },
  {
    "type": "swap",
    "key": "├─󰿡",
    "keyColor": "34"
  },
  {
    "type": "disk",
    "key": "├─󰋊",
    "keyColor": "34",
    "format": "{13} {1} / {2} ({3}) - {9} [{20}]",
    "percent": {
      "type": 3
    },
    "hideFolders": "/mnt/4tb:/boot/efi:/efi",
    "hideFS": "zfs"
  },
  {
    "type": "command",
    "key": "├─󰋊",
    "keyColor": "34",
    "format": "{1}",
    "splitLines": true,
    "text": "bash -c 'command -v zpool >/dev/null 2>&1 || exit 1; zpool list -H -o name,alloc,size,cap | while read -r name alloc size cap; do pct=${cap%%%}; filled=$((pct / 10)); [ \"$filled\" -gt 10 ] && filled=10; [ \"$filled\" -lt 0 ] && filled=0; empty=$((10 - filled)); full=\"██████████\"; hollow=\"░░░░░░░░░░\"; bar=${full:0:filled}; rest=${hollow:0:empty}; if [ \"$pct\" -lt 50 ]; then c=\"\\033[32m\"; elif [ \"$pct\" -lt 80 ]; then c=\"\\033[33m\"; else c=\"\\033[31m\"; fi; printf \"[ %b%s ] %s / %s (%s) - zfs [%s]\\n\" \"${c}${bar}\\033[0m\" \"$rest\" \"$alloc\" \"$size\" \"$cap\" \"$name\"; done'"
  },
  {
    "type": "command",
    "key": "├─󰟀",
    "keyColor": "34",
    "format": "Boot: {1}",
    "text": "bash -c '/home/troyborg/dotfiles/scripts/boot-space.sh'"
  },
  {
    "type": "localip",
    "key": "╰─󱦂",
    "keyColor": "34",
    "showIpv4": true,
    "compact": true
  },
  "break",
  {
    "type": "display",
    "key": "╭─󰹑",
    "keyColor": "33",
    "compactType": "original"
  },
  {
    "type": "de",
    "key": "├─󰧨",
    "keyColor": "33"
  },
  {
    "type": "wm",
    "key": "├─",
    "keyColor": "33"
  },
  {
    "type": "theme",
    "key": "├─󰉼",
    "keyColor": "33"
  },
  {
    "type": "icons",
    "key": "├─",
    "keyColor": "33"
  },
  {
    "type": "cursor",
    "key": "├─󰳽",
    "keyColor": "33"
  },
  {
    "type": "font",
    "key": "├─",
    "format": "{2}",
    "keyColor": "33"
  },
  {
    "type": "terminal",
    "key": "╰─",
    "format": "{3}",
    "keyColor": "33"
  },
  "break",
  {
    "type": "colors",
    "symbol": "block"
  },
  "break"
]
}
